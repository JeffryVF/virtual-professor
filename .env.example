# Local development
DEBUG=true
ROOT_PATH=/api
DATABASE_URL=postgresql+asyncpg://profesor:changeme@postgres:5432/virtual_profesor
REDIS_URL=redis://redis:6379

# Z.AI is used only for chat generation.
ZAI_API_KEY=your-z-ai-api-key
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_LLM_MODEL=glm-4.7-flash
LLM_MAX_TOKENS=350

# Cloudflare AI Search (managed RAG). Create an instance in the dashboard
# and a token with Account > AI Search:Edit and AI Search:Run.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_SEARCH_INSTANCE=virtual-professor
CLOUDFLARE_TIMEOUT_SECONDS=60

EDGE_TTS_VOICE_EN=en-US-JennyNeural
EDGE_TTS_VOICE_ES=es-ES-ElviraNeural
EDGE_TTS_RATE=+0%
TTS_MAX_TOTAL_CHARS=6000

ADMIN_API_KEY=change-this-admin-key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Administrator
JWT_SECRET_KEY=change-this-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:3000"]
UPLOAD_MAX_SIZE_MB=4
UPLOAD_MAX_PAGES=400
RAG_MIN_RELEVANCE_SCORE=0.20
RAG_RETRIEVAL_TOP_K=8
SESSION_MEMORY_MESSAGES=10
SESSION_TIMEOUT_MINUTES=30
LANGFUSE_ENABLE=false
