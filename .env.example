# Root .env file is only used as a reference for Cloudflare deployment.
# The API (Cloudflare Workers) reads its configuration from:
#   - api/wrangler.toml          → [vars] (non-secret configuration)
#   - `wrangler secret put <NAME>` → secrets (API keys, JWT secret, admin creds)

# ── Cloudflare deployment ───────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_SEARCH_INSTANCE=virtual-professor

# ── Secrets (set with `wrangler secret put`, all uppercase) ────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
JWT_SECRET_KEY=change-this-jwt-secret
ADMIN_API_KEY=change-this-admin-key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Administrator

# ── Configuration (mirrors api/wrangler.toml [vars]) ────────────────────────
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_LLM_MODEL=gemini-3.5-flash
LLM_MAX_TOKENS=350
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
RAG_MIN_RELEVANCE_SCORE=0.4
RAG_RETRIEVAL_TOP_K=8
UPLOAD_MAX_SIZE_MB=4
UPLOAD_MAX_PAGES=400
SESSION_MEMORY_MESSAGES=10
SESSION_TIMEOUT_MINUTES=30
TTS_MODEL_ES=@cf/deepgram/aura-2-es
TTS_MODEL_EN=@cf/deepgram/aura-2-en
TTS_MAX_TOTAL_CHARS=6000