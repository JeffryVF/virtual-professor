# ═══════════════════════════════════════════════════════════════
# Virtual Professor — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env
#
# For local Docker Compose development, the service URLs below
# work out of the box (they use Docker service names).
# In the cloud, replace these with your managed service URLs.
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────
# Local:     postgresql://profesor:changeme@postgres:5432/virtual_profesor
# Cloud:     postgresql://user:password@your-cloud-host:5432/dbname
POSTGRES_USER=profesor
POSTGRES_PASSWORD=changeme
POSTGRES_DB=virtual_profesor
DATABASE_URL=postgresql://profesor:changeme@postgres:5432/virtual_profesor

# ── Redis ─────────────────────────────────────────────────────
# Local:     redis://redis:6379
# Cloud:     redis://user:password@your-cloud-host:6379
REDIS_URL=redis://redis:6379

# ── Qdrant ────────────────────────────────────────────────────
# Local:     http://qdrant:6333
# Cloud:     https://your-cloud-host:6333
QDRANT_URL=http://qdrant:6333

# ── Ollama ────────────────────────────────────────────────────
# Local:     http://ollama:11434
# Cloud:     https://your-ollama-host:11434
OLLAMA_URL=http://ollama:11434
OLLAMA_LLM_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Whisper ───────────────────────────────────────────────────
# Local:     http://whisper:9000
# Cloud:     https://your-whisper-host:9000
WHISPER_URL=http://whisper:9000

# ── Kokoro TTS ────────────────────────────────────────────────
# Local:     http://kokoro:8880
# Cloud:     https://your-kokoro-host:8880
KOKORO_URL=http://kokoro:8880

# ── LiveAvatar ────────────────────────────────────────────────
# Get your API key at https://liveavatar.com
LIVEAVATAR_API_KEY=your_key_here
LIVEAVATAR_API_URL=https://api.liveavatar.com

# ── Admin ─────────────────────────────────────────────────────
# Used to authenticate requests to /admin/* endpoints.
# Generate a strong random secret for production.
ADMIN_API_KEY=changeme

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated origins (e.g., https://mydomain.com,https://app.mydomain.com)
# Use "*" to allow all origins (development only).
CORS_ORIGINS=*

# ── Session Settings ──────────────────────────────────────────
SESSION_MEMORY_MESSAGES=10
SESSION_TIMEOUT_MINUTES=30

# ── RAG ────────────────────────────────────────────────────────
# Minimum relevance score for RAG-retrieved chunks (0.0 = disable filter)
# Chunks with score below this threshold are discarded before reaching the LLM
RAG_MIN_RELEVANCE_SCORE=0.75

# ── Reranker (Cross-Encoder) ──────────────────────────────────
# Type: "none" to disable, "bge" to enable local BGE cross-encoder
# Model: HuggingFace model name for cross-encoder reranking
# Top N: number of chunks passed to the cross-encoder for re-scoring
# Device: torch device ("cpu" or "cuda" if available)
RERANKER_TYPE=none
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=5
RERANKER_DEVICE=cpu
