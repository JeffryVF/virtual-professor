{
  "name": "virtual-professor-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "db:migrate:local": "wrangler d1 migrations apply virtual-professor-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply virtual-professor-db --remote",
    "gen_token": "node scripts/gen-admin-token.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "fflate": "^0.8.2",
    "hono": "^4.6.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/bcryptjs": "^2.4.6",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "wrangler": "^3.80.0"
  }
}
